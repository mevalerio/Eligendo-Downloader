  "description": "A comprehensive TypeScript-based tool for downloading and analyzing Italian municipal election data from Eligendo",
  "main": "dist/main.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "start": "ts-node src/main.ts",
    "build": "tsc",
    "test": "jest",
    "dev": "ts-node src/municipal-demo.ts",
